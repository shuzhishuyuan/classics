# 数据库类型：sqlite（本地开发） / mysql（服务器部署）
DB_TYPE=sqlite

# JWT 签名密钥（生产环境务必换成随机字符串）
JWT_SECRET=change-me-to-random-string

# 服务端口
PORT=3001

# 运行环境：development / production
NODE_ENV=development

# 地图模块当前使用开放底图，无需额外 Key

# AI 默认配置（密钥只放服务端环境变量，不要写入前端代码）
DEEPSEEK_API_KEY=
# 可选：替换文件优先于 DEEPSEEK_API_KEY，文件内容只放一行 API Key
DEEPSEEK_API_KEY_FILE=

# --- 以下仅在 DB_TYPE=mysql 时需要 ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=shuyuan
